# Copy to .env in the repository root. Never commit credentials.
MG_ENV=development
MG_DATA_DIR=./data
# Empty uses local SQLite. On Render, set a private Neon PostgreSQL connection
# string including sslmode=require. Store this only in Render Environment.
MG_DATABASE_URL=
# On Render omit MG_APP_ORIGIN to use its automatically assigned HTTPS URL.
MG_APP_ORIGIN=http://localhost:3000
MG_COOKIE_SECURE=false
MG_ALLOW_REGISTRATION=true
MG_ALLOW_DEMO=true
MG_MAX_UPLOAD_MB=8
MG_MAX_ROWS=50000
MG_GEMINI_API_KEY=
# Set an available function-calling model for your account.
MG_GEMINI_MODEL=gemini-2.5-flash
MG_AI_TIMEOUT_SECONDS=35
MG_STATIC_DIR=./web/out
